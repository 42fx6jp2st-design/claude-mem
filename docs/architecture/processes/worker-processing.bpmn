<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_WorkerProcessing"
                  targetNamespace="https://claude-mem.ai/bpmn">
  <bpmn:process id="Process_WorkerProcessing" name="Hook to Storage Pipeline" isExecutable="false">
    <bpmn:documentation>
      How an observation travels from a fired hook through the worker to SQLite + Chroma + SSE viewer.
      Starts when PostToolUse fires; ends when all storage writes complete and UI is updated.
    </bpmn:documentation>

    <bpmn:startEvent id="Start_HookFires" name="Hook event fires&#10;(stdin JSON)"/>
    <bpmn:task id="Task_BunRunner" name="bun-runner.js (Node)&#10;find Bun, buffer stdin"/>
    <bpmn:task id="Task_WorkerCJS" name="worker-service.cjs&#10;CJS loader&#10;import TS entry"/>
    <bpmn:task id="Task_WorkerTS" name="worker-service.ts (Bun)&#10;Express on 37700+uid%100"/>
    <bpmn:task id="Task_TagStrip" name="tag-stripping.ts&#10;strip &lt;private&gt; etc.&#10;(edge boundary)"/>
    <bpmn:task id="Task_Route" name="HTTP POST&#10;/hook/claude-code/{event}&#10;→ route handler"/>
    <bpmn:task id="Task_Handler" name="Handler dispatch&#10;SessionManager / SearchManager&#10;/ Agents"/>
    <bpmn:parallelGateway id="GW_Fork"/>
    <bpmn:task id="Task_SQLite" name="SQLite write&#10;DatabaseManager&#10;observations + prompts"/>
    <bpmn:task id="Task_Queue" name="Queue for AI&#10;compression&#10;(async)"/>
    <bpmn:task id="Task_Chroma" name="ChromaSync&#10;→ chroma-mcp stdio&#10;→ Chroma vectors"/>
    <bpmn:task id="Task_SSE" name="SSEBroadcaster&#10;→ /stream&#10;→ React Viewer"/>
    <bpmn:parallelGateway id="GW_Join"/>
    <bpmn:endEvent id="End_Stored" name="Observation stored&#10;+ UI updated"/>

    <bpmn:sequenceFlow id="f1" sourceRef="Start_HookFires" targetRef="Task_BunRunner"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Task_BunRunner" targetRef="Task_WorkerCJS"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Task_WorkerCJS" targetRef="Task_WorkerTS"/>
    <bpmn:sequenceFlow id="f4" sourceRef="Task_WorkerTS" targetRef="Task_TagStrip"/>
    <bpmn:sequenceFlow id="f5" sourceRef="Task_TagStrip" targetRef="Task_Route"/>
    <bpmn:sequenceFlow id="f6" sourceRef="Task_Route" targetRef="Task_Handler"/>
    <bpmn:sequenceFlow id="f7" sourceRef="Task_Handler" targetRef="GW_Fork"/>
    <bpmn:sequenceFlow id="f8" sourceRef="GW_Fork" targetRef="Task_SQLite"/>
    <bpmn:sequenceFlow id="f9" sourceRef="GW_Fork" targetRef="Task_Queue"/>
    <bpmn:sequenceFlow id="f10" sourceRef="GW_Fork" targetRef="Task_SSE"/>
    <bpmn:sequenceFlow id="f11" sourceRef="Task_Queue" targetRef="Task_Chroma"/>
    <bpmn:sequenceFlow id="f12" sourceRef="Task_SQLite" targetRef="GW_Join"/>
    <bpmn:sequenceFlow id="f13" sourceRef="Task_Chroma" targetRef="GW_Join"/>
    <bpmn:sequenceFlow id="f14" sourceRef="Task_SSE" targetRef="GW_Join"/>
    <bpmn:sequenceFlow id="f15" sourceRef="GW_Join" targetRef="End_Stored"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_WorkerProcessing">
      <bpmndi:BPMNShape id="s1" bpmnElement="Start_HookFires"><dc:Bounds x="80" y="250" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2" bpmnElement="Task_BunRunner"><dc:Bounds x="160" y="230" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s3" bpmnElement="Task_WorkerCJS"><dc:Bounds x="330" y="230" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s4" bpmnElement="Task_WorkerTS"><dc:Bounds x="500" y="230" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s5" bpmnElement="Task_TagStrip"><dc:Bounds x="670" y="230" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s6" bpmnElement="Task_Route"><dc:Bounds x="840" y="230" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s7" bpmnElement="Task_Handler"><dc:Bounds x="1010" y="230" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s8" bpmnElement="GW_Fork"><dc:Bounds x="1180" y="245" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s9" bpmnElement="Task_SQLite"><dc:Bounds x="1270" y="100" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s10" bpmnElement="Task_Queue"><dc:Bounds x="1270" y="230" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s11" bpmnElement="Task_Chroma"><dc:Bounds x="1440" y="230" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s12" bpmnElement="Task_SSE"><dc:Bounds x="1270" y="360" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s13" bpmnElement="GW_Join"><dc:Bounds x="1620" y="245" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s14" bpmnElement="End_Stored"><dc:Bounds x="1720" y="252" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e1" bpmnElement="f1"><di:waypoint x="116" y="268"/><di:waypoint x="160" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e2" bpmnElement="f2"><di:waypoint x="300" y="270"/><di:waypoint x="330" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e3" bpmnElement="f3"><di:waypoint x="470" y="270"/><di:waypoint x="500" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e4" bpmnElement="f4"><di:waypoint x="640" y="270"/><di:waypoint x="670" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e5" bpmnElement="f5"><di:waypoint x="810" y="270"/><di:waypoint x="840" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e6" bpmnElement="f6"><di:waypoint x="980" y="270"/><di:waypoint x="1010" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e7" bpmnElement="f7"><di:waypoint x="1150" y="270"/><di:waypoint x="1180" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e8" bpmnElement="f8"><di:waypoint x="1205" y="245"/><di:waypoint x="1205" y="140"/><di:waypoint x="1270" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e9" bpmnElement="f9"><di:waypoint x="1230" y="270"/><di:waypoint x="1270" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e10" bpmnElement="f10"><di:waypoint x="1205" y="295"/><di:waypoint x="1205" y="400"/><di:waypoint x="1270" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e11" bpmnElement="f11"><di:waypoint x="1410" y="270"/><di:waypoint x="1440" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e12" bpmnElement="f12"><di:waypoint x="1410" y="140"/><di:waypoint x="1645" y="140"/><di:waypoint x="1645" y="245"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e13" bpmnElement="f13"><di:waypoint x="1580" y="270"/><di:waypoint x="1620" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e14" bpmnElement="f14"><di:waypoint x="1410" y="400"/><di:waypoint x="1645" y="400"/><di:waypoint x="1645" y="295"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e15" bpmnElement="f15"><di:waypoint x="1670" y="270"/><di:waypoint x="1720" y="270"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
